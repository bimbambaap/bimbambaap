# Server
PORT=8080

# Database (Railway geeft je deze automatisch)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT - maak dit een lange random string
JWT_SECRET=verander_dit_naar_iets_geheims_en_lang

# Cloudinary - haal deze op via cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=jouw_cloud_name
CLOUDINARY_API_KEY=jouw_api_key
CLOUDINARY_API_SECRET=jouw_api_secret
